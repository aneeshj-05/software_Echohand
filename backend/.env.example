# EchoHand Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to Git!

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=your-flask-session-secret-key-replace-in-production

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/echohand?retryWrites=true&w=majority
DATABASE_NAME=echohand

# JWT (JSON Web Token) Configuration
JWT_SECRET_KEY=your-jwt-secret-key-generate-a-strong-random-key
JWT_EXPIRATION_HOURS=168

# Password Hashing Cost Factor (Default: 12)
BCRYPT_LOG_ROUNDS=12

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
